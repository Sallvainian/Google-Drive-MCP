# Node dependencies
node_modules/
dist/

# Credentials / Tokens
credentials.json
token.json

# Log files
*.log

# Environment variables
.env*

# Backup files (use git history instead)
*.bak
src/backup/

# Bundled output files
repomix-output*

# One-off utility scripts
export-docs.mjs

# Local workspace / session files
.mcp.json

# .claude/ is TRACKED (config, hooks, skills, personalities).
# Only the disposable/large caches under it are ignored:
.claude/audio/
.claude/.agentvibes-backup/
.claude/**/.DS_Store
.claude/*.bak-*
.agents/
.playwright/
.playwright-cli/
.playwright-mcp/

# AI tool dotfiles
.cursor/
.codex/

# BMad workspace output
_bmad/
_bmad-output/

# Archived doc scan-report snapshots
docs/.archive/

# macOS
.DS_Store 
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/

# Grok CLI (bmad-loop review adapter) — local tooling, not tracked.
# Tested on grok 1.0.30: Grok discovers repo-scoped skills regardless of
# gitignore state, so this tree does not need tracking (README.md:1589
# claims otherwise; the shipped binary does not behave that way).
# Worktree checkouts get the tree via seed_files in
# .bmad-loop/profiles/grok.toml, not via git.
.grok/
